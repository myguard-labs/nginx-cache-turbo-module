*.o
*.so
.build/
# Local dynamic-module build tree used to prove a change before pushing.
# Ignored for the same reason .build/ is: it is an unpacked nginx source
# tree, so a stray `git add -A` commits thousands of upstream files.
.build-proof/
# Debug (non-sanitizer) build tree for the valgrind/helgrind soak path --
# ci/tools/soak.sh needs a plain build plus MODULE=<.so>. Same reason as above:
# an unpacked nginx source tree that a stray `git add -A` would commit.
.build-dbg/
# -O2 -g -fno-omit-frame-pointer build tree for ci/tools/perf-profile.sh
# (BUILD_ROOT=$PWD/.build-perf ci-build.sh nginx <ver> profile). Same reason as
# above: an unpacked nginx source tree that a stray `git add -A` would commit.
.build-perf/
# Configure-only tree for the carve-init parser gate (BUILD_ROOT=$PWD/.carve-tree
# ci-build.sh nginx <ver> configure). Deliberately NOT under .build/: that path
# is auto-discovered by ci/tests/unit/run.sh, which gates on
# objs/ngx_auto_config.h and would then run a suite needing COMPILED objects
# against a tree that stops at configure. Same add-everything risk as above.
.carve-tree/
__pycache__/
build/
objs/
valgrind-*.log

# Coverage artifacts (ci/tools/coverage.sh output + gcov intermediates)
coverage-report/
*.gcda
*.gcno
*.gcov

