ci/fuzz/*.profraw
# Local fuzz runs dump discovered units into the corpus dirs; keep only the
# hand-written NN_* seeds, ignore libFuzzer's hash-named discoveries.
ci/fuzz/corpus/*
!ci/fuzz/corpus/[0-9][0-9]_*
ci/fuzz/corpus_norm_args/*
!ci/fuzz/corpus_norm_args/[0-9][0-9]_*
ci/fuzz/corpus_mc/*
!ci/fuzz/corpus_mc/[0-9][0-9]_*
ci/fuzz/corpus_auto/*
!ci/fuzz/corpus_auto/[0-9][0-9]_*
ci/fuzz/corpus_blob/*
!ci/fuzz/corpus_blob/[0-9][0-9]_*

# Test::Nginx::Socket regenerates these per run (ci/t/*.t). Under
# TEST_NGINX_RANDOMIZE the scaffold hardcodes t/servroot_<port>/ as the root,
# so the dirs land in t/ regardless of where the .t files live.
/t/
# Without RANDOMIZE (a single `prove ci/t/presets/foo.t` while iterating) the
# servroot instead lands beside the .t files, as ci/t/servroot/. It holds a
# generated nginx.conf plus access/error logs -- scratch, never source.
ci/t/servroot/

# perf-profile.sh output (ci/tools/perf-profile.sh) -- perf.data + report,
# regenerated per run, not source.
ci/tools/perf-out/
