# libFuzzer dictionary for the Cookie index / Cookie AC scan / query argparse
# target (fuzz_cookie_args). 0xFF separates the query string from the Cookie
# header values in the harness input; control bytes are HEX-escaped.
sep_ff="\xff"
semi=";"
semi_sp="; "
semi_tab=";\x09"
eq="="
amp="&"
amp2="&&"
semi2=";;"
pct="%"
pct41="%41"
pct2e="%2E"
pct2b="%2B"
pct_bad="%G1"
plus="+"
dot="."
dq="\""
nul="\x00"
name_eq="a=b"
wp="wp-settings-"
wpl="wordpress_logged_in_"
sess="PHPSESSID"
suffix_u="_u"
sid="sid"
empty_eq=";=;"
