# libFuzzer dictionary for the Cache-Control / Surrogate-Control parser
# (fuzz_cache_control). Whitespace and the 0xFF field-line separator are
# HEX-escaped (libFuzzer rejects literal \t/\n/\r).
max_age="max-age="
s_maxage="s-maxage="
swr="stale-while-revalidate="
sie="stale-if-error="
no_cache="no-cache"
no_store="no-store"
private="private"
public="public"
must_reval="must-revalidate"
proxy_reval="proxy-revalidate"
eq="="
comma=","
comma_sp=", "
quote="\x22"
quote_pair="\x5c\x22"
backslash="\x5c"
sp="\x20"
tab="\x09"
nul="\x00"
ctl="\x01\x1f\x7f"
obs="\x80\xe9"
sep="\xff"
tag_cc="\xff\x00"
tag_sc="\xff\x01"
tag_cc_lower="\xff\x02"
tag_other="\xff\x03"
tag_hash0="\xff\x04"
max="9223372036854775807"
max1="9223372036854775808"
big="99999999999999999999"
neg="-1"
plus="+1"
zeros="000000000000000000000"
