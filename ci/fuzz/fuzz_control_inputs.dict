# libFuzzer dictionary for the control-input target (fuzz_control_inputs).
# 0xFF separates the hex string, the tag value and the warm list in the harness
# input; control bytes are HEX-escaped.
sep_ff="\xff"
pct="%"
pct_2f="%2F"
pct_2e="%2e%2E"
pct_00="%00"
pct_zz="%zz"
pct_g="%g"
pct_trunc="%4"
hex_lo="0a1b2c3d4e5f"
hex_up="0A1B2C3D4E5F"
hex_bad="0g"
comma=","
comma_run=",,,,"
space=" "
tab="\x09"
cr="\x0d"
crlf="\x0d\x0a"
lf="\x0a"
nul="\x00"
dotdot="/.."
dotdot2="/../"
dot_seg="/./"
slash="/"
slash_a="/a"
query="?"
query_kv="?a=b&c=d"
comma_slash=",/"
lf_slash="\x0a/"
tag_a="tag-a"
tag_b="tag-b"
