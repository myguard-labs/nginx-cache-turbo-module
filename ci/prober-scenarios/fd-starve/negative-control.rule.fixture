#
# Deliberately red: with five idle sockets parked, the worker cannot retain the
# healthy unpressured free-slot count. driver.sh requires the probe comparison's
# own diagnostic so an unrelated failure does not satisfy this control.
name    NEGATIVE CONTROL: parked sockets must reduce free slots
from    127.0.0.1
send    GET /cached/item HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
expect  header~X-Cache: HIT
open_conns 5
probe   connections.free >= 6
delta   fds == 0
