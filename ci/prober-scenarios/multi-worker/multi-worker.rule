#
# S25 port of testkit's scenarios/multi-worker against a real cache_turbo
# HIT path (../nginx.conf), not the bare `return 200` the generic conf ships.
#
# THE MODULE-SPECIFIC CLAIM THIS ADDS OVER UPSTREAM'S FORM: one cold request
# populates cache_turbo's shared-memory zone, then `fanout 24 2` requires the
# warm HIT path to be observed across at least two distinct workers. Incomplete
# worker coverage is a failure, never an "almost certainly" assumption.

name    baseline: warm-up MISS across the worker set
from    127.0.0.1
send    GET /cached/item HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
expect_not header~X-Cache:
pid_may_change

name    warm object is a HIT from at least two distinct workers
from    127.0.0.1
send    GET /cached/item HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
expect  header~X-Cache: HIT
pid_may_change
fanout  24 2

name    server graceful under the worker set: no signal deaths, no [emerg]/[crit]
from    127.0.0.1
send    GET /cached/item HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
expect  header~X-Cache: HIT
pid_may_change
no_error_log  \[error\]
