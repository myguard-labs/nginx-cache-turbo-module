# Valgrind leak suppressions for nginx CORE allocations that are intentionally
# never freed when nginx runs to exit (especially in --single-process mode used
# by the CI soak jobs). These are nginx's own arenas, not this module — each
# suppression is pinned to the specific nginx core frame so a real leak in the
# module (which always carries an ngx_http_cache_turbo_* frame) is never hidden.

{
   nginx-set-environment-not-freed-at-exit
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   fun:malloc
   fun:ngx_alloc
   fun:ngx_set_environment
}

{
   nginx-event-process-init-arena-not-freed-at-exit
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   fun:malloc
   fun:ngx_alloc
   fun:ngx_event_process_init
}

# Helgrind cannot track nginx's PROCESS-shared shm mutex (ngx_shmtx uses a
# sem_t in shared memory, posted by a different PROCESS), so it reports
# "Bug in libpthread: sem_wait succeeded on semaphore without prior sem_post"
# on every ngx_shmtx_lock. Single-threaded (Thread #1) and not a data race:
# helgrind is a THREAD tool being shown cross-process synchronization.
#
# ⚠ Pinned to sem_wait_WRK -> ngx_shmtx_lock ONLY. Do NOT widen it to the
# cache_turbo frames above it in the stack: a genuine race inside the module
# must still be reported. Added 2026-08-24, after fixing the gate bug that had
# been hiding every valgrind/helgrind finding.
{
   nginx-shmtx-process-shared-sem-helgrind-cannot-track
   Helgrind:Misc
   fun:sem_wait_WRK
   fun:ngx_shmtx_lock
}
